# Afritaðu þessa skrá yfir í `.streamlit/secrets.toml` (sem er ignored í git)
# eða límdu innihaldið inn á Streamlit Cloud → App settings → Secrets.

[supabase]
url      = "https://YOUR-PROJECT-REF.supabase.co"
anon_key = "YOUR_ANON_KEY_HERE"

# Athugið: aðeins anon key fer hér. Service-role key má ALDREI hýsa á
# Streamlit Cloud — það er fyrir greiningu/útflutning og á að vera vistað
# bara á tölvunni þinni.
